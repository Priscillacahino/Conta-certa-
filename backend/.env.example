# NUNCA envie este arquivo preenchido ao GitHub.
# Produção
DJANGO_ENV=production
DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-40-caracteres
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=seu-backend.vercel.app
DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require
CORS_ALLOWED_ORIGINS=https://priscillacahino.github.io,https://conta-certa-dusky-seven.vercel.app

# Sessões e proteção contra força bruta
SESSION_HOURS=12
RESIDENT_SESSION_DAYS=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_BLOCK_MINUTES=10

# Segurança HTTP
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_MAX_REQUEST_BYTES=12582912

# Admin web do Django: mantenha desativado em produção.
ENABLE_DJANGO_ADMIN=0
